# Public site origin used for canonical URLs, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://pexbitmedia.com

# Optional HTTPS endpoint. When set, sanitized strategy-call requests are forwarded as JSON.
CONTACT_WEBHOOK_URL=

# Resend API key for contact form emails (admin notify + customer thank-you).
# Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=

# Optional. Defaults to "Pexbit Media <onboarding@resend.dev>" until a custom domain is verified.
RESEND_FROM=

# Optional. Defaults to pexbitmedia@gmail.com
CONTACT_NOTIFY_EMAIL=pexbitmedia@gmail.com

# Server-only. YouTube Data API v3 key used to load the channel showreel.
# Never prefix this with NEXT_PUBLIC_.
YOUTUBE_API_KEY=
